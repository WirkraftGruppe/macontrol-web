# Plantilla de variables de entorno. Copiar los valores reales al entorno; .env no se versiona ni se lee.

# Requeridas
SECRET_KEY=
DJANGO_ENV=development
DATABASE_URL=

# Opcionales
ALLOWED_HOSTS=
MEDIA_ROOT=
STORAGE_BACKEND=local
SITE_URL=

# Solo cuando STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
