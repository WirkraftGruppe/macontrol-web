# Plantilla de variables de entorno. Copiar los valores reales al entorno; .env no se versiona ni se lee.

# Requeridas
SECRET_KEY=
# Local: development. Hosting: production (obligatorio, sin valor por defecto).
DJANGO_ENV=
DATABASE_URL=

# Requerida en producción: sin ella, toda petición da 400.
ALLOWED_HOSTS=

# Requeridas en producción (el arranque aborta sin ellas):
# cantidad de proxies inversos de confianza delante de Django (entero >= 0, solo dígitos).
NUM_PROXIES=
# Origen público del sitio, con https:// (canonical, Open Graph y sitemap).
SITE_URL=

# Orígenes https del sitio, separados por comas (obligatorio detrás del proxy del hosting).
CSRF_TRUSTED_ORIGINS=

# Opcionales
# En el hosting: /data/media, dentro del volumen montado en /data.
MEDIA_ROOT=
